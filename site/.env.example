# Copy to `site/.env` (which is git-ignored) and fill in.
#
# VITE_TARGET is NOT here on purpose — the site build sets it itself in
# site/vite.config.ts, so it cannot be forgotten.

# The deployed origin, used for canonical and og:url tags. Blank in dev; a
# real deploy pipeline should set this in CI rather than in a file.
VITE_SITE_ORIGIN=

# Only needed to run scripts/gen_sd35.py (image generation for marketing art).
# Nothing in the site build reads it. Never commit a real value.
HUGGING_FACE_TOKEN=
