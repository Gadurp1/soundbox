{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundbox",
  "version": "0.4.0",
  "identifier": "audio.soundbox.desktop",
  "build": {
    "frontendDist": "./splash",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*",
        "img-src": "'self' data: blob: http://127.0.0.1:* http://localhost:*",
        "media-src": "'self' data: blob: http://127.0.0.1:* http://localhost:*",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local sound effects, music and speech from open-weight models",
    "longDescription": "Generate sound effects, music and speech locally from open-weight models. Includes an HTTP API and an MCP server so coding agents can generate audio directly."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzNEIyQzQ3MTQyOEJFM0EKUldRNnZpZ1VSeXhMWXpoc0hmZzc5TVh2dTdraytLMmtSZnlmY2hrZ0szZzFKQmsvTjVFYXRQeG8K",
      "endpoints": [
        "https://github.com/HamSanders/soundbox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
