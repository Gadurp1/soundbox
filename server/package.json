{
  "name": "@soundbox/server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Soundbox backend: HTTP API + MCP server driving audio.cpp",
  "license": "MIT",
  "homepage": "https://github.com/Gadurp1/soundbox#readme",
  "bugs": {
    "url": "https://github.com/Gadurp1/soundbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Gadurp1/soundbox.git",
    "directory": "server"
  },
  "bin": {
    "soundbox": "./dist/cli.js",
    "soundbox-mcp": "./dist/mcp/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^8.1.1",
    "@huggingface/hub": "^2.17.8",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.12.7",
    "wavefile": "^11.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.13.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
