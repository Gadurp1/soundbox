# Soundbox environment variables.
#
# Every variable here is optional. Soundbox does not load a .env file
# automatically: export these in your shell (or launcher / service manager)
# before starting the server or building the app. Copying this file to .env is
# a convenient private place to keep them — .env is gitignored, this file is
# not. Never commit a real token.

# --- Hugging Face -------------------------------------------------------------
# Read token for gated model downloads (e.g. the Stability models). Accept the
# model's licence on huggingface.co first. A token pasted into Settings in the
# app takes precedence over the environment.
HF_TOKEN=
# Alternative name, read only when HF_TOKEN is unset.
# HUGGING_FACE_HUB_TOKEN=
# Hugging Face cache directory. Defaults to <data dir>/models when unset.
# HF_HOME=

# --- Server -------------------------------------------------------------------
# Data directory (library, settings.json, models, logs). Default: ~/.soundbox
# SOUNDBOX_DATA_DIR=
# Server port used by `npm run dev`. Default: 17494
# SOUNDBOX_PORT=
# Extra Host header values to accept (comma-separated), for a server bound to
# something other than loopback. The server has no auth — see SECURITY.md.
# SOUNDBOX_ALLOWED_HOSTS=
# Log file path. The server sets this itself at startup; you rarely need it.
# SOUNDBOX_LOG_FILE=
# OpenTelemetry OTLP endpoint for MCP call traces. Overrides the Settings value.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# --- MCP stdio bridge ---------------------------------------------------------
# Server the stdio MCP bridge talks to. Default: http://127.0.0.1:17494
# SOUNDBOX_URL=

# --- Native binaries ----------------------------------------------------------
# Use your own build instead of the managed download.
# SOUNDBOX_AUDIOCPP_BIN=
# SOUNDBOX_LLAMA_SERVER_BIN=
# SOUNDBOX_SD_SERVER_BIN=
# Force the backend variant instead of auto-detecting it.
# SOUNDBOX_AUDIOCPP_BACKEND=
# SOUNDBOX_LLAMA_SERVER_BACKEND=
# SOUNDBOX_SD_SERVER_BACKEND=
# Install a managed engine download that no checksum covers (neither GitHub's
# asset digest nor a published manifest). Off by default: such a download is
# refused. Set to 1 only if you trust the release anyway.
# SOUNDBOX_ALLOW_UNVERIFIED_BINARIES=

# --- App (Vite, read at build/dev time) -----------------------------------------
# Run the app against the in-memory mock backend instead of a server.
# VITE_MOCK=1
# Repository URL used by marketing links (for forks).
# VITE_REPO_URL=https://github.com/Gadurp1/soundbox
# Absolute origin for canonical/OG URLs on the public /sfx pages.
# VITE_SITE_ORIGIN=
# App dev-server port. Default: 5174
# PORT=
